# This is the top-most .editorconfig file; do not search in parent directories.
root = true

# All files.
[*]
end_of_line = LF
indent_style = space
indent_size = 2
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{json,lock}]
indent_size = 4

[package.json]
indent_size = 2

#;< DEV_ESLINT
[.eslintrc.json]
indent_size = 2

[.prettierrc.json]
indent_size = 2
#;> DEV_ESLINT

[*.xml]
indent_size = 4
#;< DEV_MAKEFILE

[Makefile*]
indent_style = tab
#;> DEV_MAKEFILE
