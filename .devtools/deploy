#!/usr/bin/env php
<?php

/**
 * @file
 * Deploy code to a remote repository.
 *
 * - Configures local git.
 * - Force-pushes code to a remote code repository branch, or only a tag when
 *   DEPLOY_TAG is set.
 *
 * Add the following variables through CI provider UI.
 * - DEPLOY_USER_NAME - name of the user who will be committing to a remote
 *   repository.
 * - DEPLOY_USER_EMAIL - email address of the user who will be committing to a
 *   remote repository.
 * - DEPLOY_REMOTE - remote repository to push code to.
 * - DEPLOY_PROCEED - set to 1 if the deployment should proceed. Useful for
 *   testing CI configuration before an actual code push.
 */

declare(strict_types=1);

namespace DrevOps\Eddy\DevTools;

require_once __DIR__ . '/helpers.php';

// -----------------------------------------------------------------------------
// Variables.
// -----------------------------------------------------------------------------

// Name of the user who will be committing to a remote repository.
$deploy_user_name = getenv_required('DEPLOY_USER_NAME');

// Email address of the user who will be committing to a remote repository.
$deploy_user_email = getenv_required('DEPLOY_USER_EMAIL');

// Remote repository to push code to.
$deploy_remote = getenv_required('DEPLOY_REMOTE');

// Git branch to deploy. If not provided - current branch will be used.
$deploy_branch = getenv_default('DEPLOY_BRANCH', '');

// Git tag to deploy. When set, only this tag is pushed and DEPLOY_BRANCH is
// ignored.
$deploy_tag = getenv_default('DEPLOY_TAG', '');

// Set to 1 if the deployment should proceed. Useful for testing CI
// configuration before an actual code push.
$deploy_proceed = getenv_default('DEPLOY_PROCEED', '0');

// -----------------------------------------------------------------------------

echo '===============================' . PHP_EOL;
echo '           🚚 DEPLOY           ' . PHP_EOL;
echo '===============================' . PHP_EOL;
echo PHP_EOL;

if ($deploy_proceed !== '1') {
  PASS('Skip deployment because DEPLOY_PROCEED is not set to 1.');
  quit(0);
}

if ($deploy_tag === '' && $deploy_branch === '') {
  $deploy_branch = trim((string) shell_exec('git symbolic-ref --short HEAD'));
}

$git_user_name = trim((string) shell_exec('git config --global user.name'));
if ($git_user_name === '') {
  TASK('Configuring global git user name %s.', $deploy_user_name);
  passthru_or_fail(sprintf('git config --global user.name %s', escapeshellarg($deploy_user_name)));
}

$git_user_email = trim((string) shell_exec('git config --global user.email'));
if ($git_user_email === '') {
  TASK('Configuring global git user email %s.', $deploy_user_email);
  passthru_or_fail(sprintf('git config --global user.email %s', escapeshellarg($deploy_user_email)));
}

TASK('Setting git to push to a matching remote branch.');
passthru_or_fail('git config --global push.default matching');

TASK('Adding remote %s.', $deploy_remote);
passthru_or_fail(sprintf('git remote add deployremote %s', escapeshellarg($deploy_remote)));

if ($deploy_tag !== '') {
  TASK('Pushing tag %s.', $deploy_tag);
  // The full refspec cannot resolve to a branch that shares the tag's name.
  passthru_or_fail(sprintf('git push --force deployremote %s', escapeshellarg('refs/tags/' . $deploy_tag)));
  PASS('Tag pushed to %s:%s.', $deploy_remote, $deploy_tag);
}
else {
  TASK('Pushing code to branch %s.', $deploy_branch);
  passthru_or_fail(sprintf('git push --force deployremote HEAD:%s', escapeshellarg($deploy_branch)));
  PASS('Code pushed to %s:%s.', $deploy_remote, $deploy_branch);

  TASK('Pushing tags.');
  $tags_exit_code = 0;
  $tags_output = passthru_capture('git push --force --tags deployremote', $tags_exit_code);

  if ($tags_exit_code === 0) {
    PASS('Tags pushed to %s.', $deploy_remote);
  }
  else {
    // The remote can refuse individual tags without affecting the branch.
    echo $tags_output;
    INFO('Some tags were not pushed to %s.', $deploy_remote);
  }
}

echo '===============================' . PHP_EOL;
echo '     🚚 DEPLOY COMPLETE ✅    ' . PHP_EOL;
echo '===============================' . PHP_EOL;
echo PHP_EOL;
echo 'Remote URL    : ' . $deploy_remote . PHP_EOL;

if ($deploy_tag !== '') {
  echo 'Remote tag    : ' . $deploy_tag . PHP_EOL;
}
else {
  echo 'Remote branch : ' . $deploy_branch . PHP_EOL;
}

echo PHP_EOL;
echo '> Next steps:' . PHP_EOL;
echo '  Navigate to Drupal.org and check that the code was successfully pushed.' . PHP_EOL;
echo PHP_EOL;
