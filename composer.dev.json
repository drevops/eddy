{
    "require-dev": {
        "behat/mink": "^1.13",
        "behat/mink-browserkit-driver": "^2.3",
        "cweagans/composer-patches": "^2.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2.1",
        "drevops/eddy-tooling": "~1.2.0",
        "drevops/phpcs-standard": "^0.6.2",
        "drupal/coder": "^8.3.31 || ^9.0.1",
        "drupal/sdc_devel": "^1.1",
        "drush/drush": "^12.5.3 || ^13.8 || ^14",
        "jangregor/phpstan-prophecy": "^1.0.2 || ^2.3",
        "lullabot/mink-selenium2-driver": "^1.7.4 || ^2",
        "mglaman/phpstan-drupal": "^1.3.9 || ^2.4",
        "mikey179/vfsstream": "^1.6.12",
        "palantirnet/drupal-rector": "^1.1.3",
        "phpcompatibility/php-compatibility": "^9.3.5 || ^10.0.0-alpha3",
        "phpspec/prophecy-phpunit": "^2.5",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan-phpunit": "^1.4.2 || ^2.1.3",
        "phpunit/phpunit": "^9.6.39 || ^10.5.67 || ^11.5.58",
        "symfony/browser-kit": "^6.4.51 || ^7.4.24 || ^8.1.12",
        "symfony/css-selector": "^6.4.49 || ^7.4.22 || ^8.1.10",
        "symfony/dom-crawler": "^6.4.49 || ^7.4.22 || ^8.1.10",
        "vincentlanglet/twig-cs-fixer": "^3.14.0"
    },
    "config": {
        "allow-plugins": {
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "eddy": {
            "drupal-version": "11"
        },
        "phpcodesniffer-search-depth": 10,
        "patches": {},
        "drupal-scaffold": {
            "file-mapping": {
                "[web-root]/.eslintrc.json": false
            }
        }
    }
}
