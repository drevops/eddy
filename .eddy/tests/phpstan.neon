##
# Configuration file for PHPStan static code checking, see https://phpstan.org .
#

parameters:

  level: 9

  paths:
    - src
    - ../assets/update-assets.php
    - ../../.devtools/assemble
    - ../../.devtools/browser
    - ../../.devtools/deploy
    - ../../.devtools/helpers.php
    - ../../.devtools/info
    - ../../.devtools/provision
    - ../../.devtools/qrcode
    - ../../.devtools/start
    - ../../.devtools/stop
    - ../../init.php

  scanFiles:
    - ../../init.php

  excludePaths:
    - vendor/*
    - node_modules/*

  ignoreErrors:
    -
      # Tests and data providers do not require parameter docblocks, so the
      # parameter type cannot be specified. The ignore has no 'paths', so it
      # also covers the '.devtools' scripts and 'init.php'.
      message: '#.*no value type specified in iterable type array.#'
      reportUnmatched: false
    -
      # Devtools scripts decode JSON into mixed arrays and access nested keys
      # directly; strict offset typing is impractical for these scripts.
      identifier: offsetAccess.nonOffsetAccessible
      paths:
        - ../../.devtools/*
      reportUnmatched: false
