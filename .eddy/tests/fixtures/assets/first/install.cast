[1.005, "o", "\u001b[4A\r\u001b[J\u001b[36m◆\u001b[0m  Extension name (1)\r\r\n\u001b[90m│\u001b[0m  \u001b[2mYour Extension\u001b[0m\r\r\n\u001b[90m│\u001b[0m\r\r\n\u001b[36m◇\u001b[0m  Machine name \u001b[2m(2)\u001b[0m\r\r\n\u001b[90m│\u001b[0m\r\r\n\u001b[90m│\u001b[0m  \u001b[90mmy_extension\u001b[0m\u001b[36m█\u001b[0m\r\r\n\u001b[90m│\u001b[0m\r\r\n"]
[1.004, "o", "\u001b[4A\r\u001b[J\u001b[36m◆\u001b[0m  Machine name (2)\r\r\n\u001b[90m│\u001b[0m  \u001b[2mmy_extension\u001b[0m\r\r\n\u001b[90m│\u001b[0m\r\r\n\u001b[36m◇\u001b[0m  Extension type \u001b[2m(3)\u001b[0m\r\r\n\u001b[90m│\u001b[0m\r\r\n\u001b[90m│\u001b[0m\u001b[36m❯\u001b[0m \u001b[32m●\u001b[0m Module\r\r\n\u001b[90m│\u001b[0m  \u001b[2m○\u001b[0m \u001b[2mTheme\u001b[0m\r\r\n\u001b[90m│\u001b[0m\r\r\n"]
[1.016, "o", "\u001b[5A\r\u001b[J\u001b[36m◆\u001b[0m  Extension type (3)\r\r\n\u001b[90m│\u001b[0m  \u001b[2mModule\u001b[0m\r\r\n\u001b[90m│\u001b[0m\r\r\n\u001b[36m◇\u001b[0m  Target Drupal versions \u001b[2m(4)\u001b[0m\r\r\n\u001b[90m│\u001b[0m  \u001b[2;3mCI runs against every selected major. Check any other major you also support.\u001b[0m\r\r\n\u001b[90m│\u001b[0m\r\r\n\u001b[90m│\u001b[0m\u001b[36m❯\u001b[0m \u001b[32m◻\u001b[0m Drupal 10\r\r\n\u001b[90m│\u001b[0m  \u001b[32m◼\u001b[0m Drupal 11\r\r\n\u001b[90m│\u001b[0m  \u001b[2m◻\u001b[0m \u001b[2mDrupal 12\u001b[0m\r\r\n\u001b[90m│\u001b[0m\r\r\n"]
[1.006, "o", "\u001b[7A\r\u001b[J\u001b[36m◆\u001b[0m  Target Drupal versions (4)\r\r\n\u001b[90m│\u001b[0m  \u001b[2mDrupal 11\u001b[0m\r\r\n\u001b[90m│\u001b[0m\r\r\n\u001b[36m◇\u001b[0m  Command wrapper \u001b[2m(5)\u001b[0m\r\r\n\u001b[90m│\u001b[0m\r\r\n\u001b[90m│\u001b[0m\u001b[36m❯\u001b[0m \u001b[32m◻\u001b[0m Ahoy\r\r\n\u001b[90m│\u001b[0m  \u001b[2m◻\u001b[0m \u001b[2mMakefile\u001b[0m\r\r\n\u001b[90m│\u001b[0m\r\r\n"]
[1.005, "o", "\u001b[5A\r\u001b[J\u001b[36m◇\u001b[0m  Command wrapper \u001b[2m(5)\u001b[0m\r\r\n\u001b[90m│\u001b[0m\r\r\n\u001b[90m│\u001b[0m\u001b[36m❯\u001b[0m \u001b[32m◼\u001b[0m Ahoy\r\r\n\u001b[90m│\u001b[0m  \u001b[2m◻\u001b[0m \u001b[2mMakefile\u001b[0m\r\r\n\u001b[90m│\u001b[0m\r\r\n"]
[1.003, "o", "\u001b[5A\r\u001b[J\u001b[36m◆\u001b[0m  Command wrapper (5)\r\r\n\u001b[90m│\u001b[0m  \u001b[2mAhoy\u001b[0m\r\r\n\u001b[90m│\u001b[0m\r\r\n\u001b[36m◇\u001b[0m  Tools \u001b[2m(6)\u001b[0m\r\r\n\u001b[90m│\u001b[0m  \u001b[2;3mAll tools are included by default. Uncheck any to remove from your project.\u001b[0m\r\r\n\u001b[90m│\u001b[0m\r\r\n\u001b[90m│\u001b[0m\u001b[36m❯\u001b[0m \u001b[32m◼\u001b[0m PHPCS\r\r\n\u001b[90m│\u001b[0m  \u001b[32m◼\u001b[0m PHPStan\r\r\n\u001b[90m│\u001b[0m  \u001b[32m◼\u001b[0m Rector\r\r\n\u001b[90m│\u001b[0m  \u001b[32m◼\u001b[0m Twig CS Fixer\r\r\n\u001b[90m│\u001b[0m  \u001b[32m◼\u001b[0m ESLint\r\r\n\u001b[90m│\u001b[0m  \u001b[32m◼\u001b[0m Stylelint\r\r\n\u001b[90m│\u001b[0m  \u001b[32m◼\u001b[0m CSpell\r\r\n\u001b[90m│\u001b[0m  \u001b[32m◼\u001b[0m Jest\r\r\n\u001b[90m│\u001b[0m  \u001b[32m◼\u001b[0m PHPUnit\r\r\n\u001b[90m│\u001b[0m  \u001b[32m◼\u001b[0m FunctionalJavascript tests\r\r\n\u001b[90m│\u001b[0m  \u001b[32m◼\u001b[0m Renovate\r\r\n\u001b[90m│\u001b[0m\r\r\n"]
[1.008, "o", "\u001b[15A\r\u001b[J\u001b[36m◆\u001b[0m  Tools (6)\r\r\n\u001b[90m│\u001b[0m  \u001b[2mPHPCS, PHPStan, Rector, Twig CS Fixer, ESLint, Stylelint, CSpell, Jest, PHPUnit, FunctionalJavascript tests, Renovate\u001b[0m\r\r\n\u001b[90m│\u001b[0m\r\r\n\u001b[36m◇\u001b[0m  Keep example lifecycle scripts \u001b[2m(7)\u001b[0m\r\r\n\u001b[90m│\u001b[0m  \u001b[2;3mSample hooks that only print a marker line when each build phase runs. Keep them as a starting point for your own scripts.\u001b[0m\r\r\n\u001b[90m│\u001b[0m\r\r\n\u001b[90m│\u001b[0m  \u001b[2m○\u001b[0m \u001b[2mYes\u001b[0m \u001b[2m/\u001b[0m \u001b[32m●\u001b[0m No\r\r\n\u001b[90m│\u001b[0m\r\r\n"]
[1.004, "o", "\u001b[5A\r\u001b[J\u001b[36m◆\u001b[0m  Keep example lifecycle scripts (7)\r\r\n\u001b[90m│\u001b[0m  \u001b[2mNo\u001b[0m\r\r\n\u001b[90m│\u001b[0m\r\r\n\u001b[36m◇\u001b[0m  Remove this script \u001b[2m(8)\u001b[0m\r\r\n\u001b[90m│\u001b[0m\r\r\n\u001b[90m│\u001b[0m  \u001b[32m●\u001b[0m Yes \u001b[2m/\u001b[0m \u001b[2m○\u001b[0m \u001b[2mNo\u001b[0m\r\r\n\u001b[90m│\u001b[0m\r\r\n"]
