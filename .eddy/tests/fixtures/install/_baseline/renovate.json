{
    "extends": ["config:recommended"],
    "automerge": true,
    "rangeStrategy": "bump",
    "minimumReleaseAge": "7 days",
    "minimumReleaseAgePackageManagerSync": true,
    "internalChecksFilter": "strict",
    "lockFileMaintenance": {
        "enabled": true
    },
    "dependencyDashboard": {
        "enabled": true
    },
    "pinDigests": true,
    "branchPrefix": "deps/",
    "enabledManagers": ["github-actions", "npm"],
    "packageRules": [
        {
            "matchDepNames": ["node", "yarn"],
            "matchManagers": ["npm"],
            "enabled": false
        },
        {
            "matchManagers": ["npm"],
            "matchUpdateTypes": ["major"],
            "enabled": false
        },
        {
            "matchPackageNames": ["*"],
            "groupName": "all dependencies",
            "groupSlug": "all"
        },
        {
            "matchManagers": ["npm"],
            "matchDepTypes": ["dependencies"],
            "groupName": "runtime dependencies",
            "groupSlug": "runtime",
            "automerge": false
        }
    ]
}
