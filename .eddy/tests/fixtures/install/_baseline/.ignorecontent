^package-lock.json
# Tool-removal edits make '.gitattributes' differ per dataset; storing those
# diffs as fixtures makes git mis-read the hunk headers as attribute rules.
# Removal is asserted directly in 'InstallProcessTest::testProcessRemovesGitattributes'.
^.gitattributes
install.php

