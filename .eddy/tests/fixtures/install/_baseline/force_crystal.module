<?php

/**
 * @file
 * Code for force_crystal module.
 *
 * Adds a <noscript> tag holding the text set in the configuration form,
 * shown only when JavaScript is disabled, plus a
 * div[data-force_crystal-time] element that js/force_crystal.js fills
 * with the page load time. Attaches the force_crystal/global library to
 * every page.
 */

declare(strict_types=1);

/**
 * Implements hook_page_attachments().
 */
function force_crystal_page_attachments(array &$attachments): void {
  $attachments['#attached']['library'][] = 'force_crystal/global';
}

/**
 * Implements hook_page_bottom().
 */
function force_crystal_page_bottom(array &$page_bottom): void {
  /** @var \Drupal\force_crystal\ForceCrystalService $force_crystal_service */
  $force_crystal_service = \Drupal::service('force_crystal.service');

  $text = $force_crystal_service->getText();

  if (!empty($text)) {
    $page_bottom['force_crystal'] = [
      '#type' => 'html_tag',
      '#tag' => 'noscript',
      '#value' => $text,
    ];
  }

  $page_bottom['force_crystal_time'] = [
    '#type' => 'html_tag',
    '#tag' => 'div',
    '#attributes' => [
      'data-force_crystal-time' => TRUE,
    ],
  ];
}
