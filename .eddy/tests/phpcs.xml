<?xml version="1.0"?>
<ruleset name="custom">
    <description>Custom PHPCS standard for Eddy tests.</description>

    <rule ref="Drupal"/>
    <rule ref="Generic.PHP.RequireStrictTypes" />
    <rule ref="DrevOps"/>

    <!-- Show sniff codes in all reports -->
    <arg value="s"/>
    <!-- Show progress of the run. -->
    <arg value="p"/>
    <arg name="colors"/>

    <file>src</file>
    <file>../assets/update-assets.php</file>
    <file>../../.eddy/tooling/src/eddy-assemble</file>
    <file>../../.eddy/tooling/src/eddy-browser-start</file>
    <file>../../.eddy/tooling/src/eddy-browser-stop</file>
    <file>../../.eddy/tooling/src/eddy-deploy</file>
    <file>../../.eddy/tooling/src/helpers.php</file>
    <file>../../.eddy/tooling/src/eddy-info</file>
    <file>../../.eddy/tooling/src/eddy-provision</file>
    <file>../../.eddy/tooling/src/eddy-qrcode</file>
    <file>../../.eddy/tooling/src/eddy-start</file>
    <file>../../.eddy/tooling/src/eddy-stop</file>
    <file>../../install.php</file>
    <file>../../scripts/eddy-tooling</file>

    <!-- Allow long array lines in tests. -->
    <rule ref="Drupal.Arrays.Array.LongLineDeclaration">
        <exclude-pattern>*.Test\.php</exclude-pattern>
        <exclude-pattern>*.TestCase\.php</exclude-pattern>
        <exclude-pattern>*.test</exclude-pattern>
    </rule>

    <!-- Allow missing comments in tests. -->
    <rule ref="Drupal.Commenting">
        <exclude-pattern>*.Test\.php</exclude-pattern>
        <exclude-pattern>*.TestCase\.php</exclude-pattern>
        <exclude-pattern>*.test</exclude-pattern>
    </rule>

    <!-- Allow file description in scripts. -->
    <rule ref="Drupal.Commenting.FileComment.NamespaceNoFileDoc">
        <exclude-pattern>install\.php</exclude-pattern>
    </rule>

    <!-- Allow a blank line after the section dividers in tooling scripts. -->
    <rule ref="Drupal.Commenting.InlineComment.SpacingAfter">
        <exclude-pattern>*/tooling/src/eddy-*</exclude-pattern>
    </rule>

    <!-- 'eddy-info' is a PHP script, not a Drupal '.info' file. -->
    <rule ref="Drupal.InfoFiles">
        <exclude-pattern>*/tooling/src/eddy-info</exclude-pattern>
    </rule>
</ruleset>
