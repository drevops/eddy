#!/usr/bin/env php
<?php

/**
 * @file
 * Start development environment.
 */

declare(strict_types=1);

namespace DrevOps\Eddy\Tooling;

require_once __DIR__ . '/helpers.php';

// -----------------------------------------------------------------------------
// Variables.
// -----------------------------------------------------------------------------

// Webserver host and port. The helper resolves both via the
// env -> '.env' -> default chain. With auto_discover: TRUE, a free
// port is allocated and persisted to '.env' when neither env nor
// '.env' provides one.
$webserver = resolve_webserver(auto_discover: TRUE);
$webserver_host = $webserver['host'];
$webserver_port = $webserver['port'];

// Webserver wait timeout.
$webserver_wait_timeout = validate_timeout_or_fail(getenv_default('WEBSERVER_WAIT_TIMEOUT', '5'), 'WEBSERVER_WAIT_TIMEOUT');

// Webserver log file.
$webserver_log = '.logs/php.log';

// The docroot identifies the webserver of this project among the processes
// that listen on the port.
$root = (string) getcwd();
$docroot = $root . '/build/web';

// Enable XDebug when XDebug env var is set. XDebug extension must be installed
// and configured on host environment (php -v should show `with Xdebug`).
// The flags apply only to the development server, so test commands keep pcov
// as the coverage driver.
$xdebug_enabled = getenv_default('XDEBUG', '') !== '';
$xdebug_flags = $xdebug_enabled ? ' -d xdebug.mode=debug -d xdebug.start_with_request=yes' : '';

// -----------------------------------------------------------------------------

echo '===============================' . PHP_EOL;
echo '      💻 START ENVIRONMENT     ' . PHP_EOL;
echo '===============================' . PHP_EOL;
echo PHP_EOL;

if ($xdebug_enabled) {
  TASK('Verifying that the XDebug PHP extension is installed.');
  $output = (string) shell_exec('php -v 2>/dev/null');

  if (stripos($output, 'xdebug') === FALSE) {
    FAIL('XDEBUG=1 is set but the XDebug PHP extension is not installed on the host. Install it (see https://xdebug.org/docs/install) and try again.');
  }

  PASS('XDebug extension is loaded.');
}

TASK('Stopping previously started services, if any.');
$listeners = webserver_listeners($webserver_port, $docroot);

if ($listeners['other'] !== []) {
  FAIL_NO_EXIT('Port %s is in use by another process. Stop it, or set WEBSERVER_PORT in .env to a free port.', $webserver_port);

  foreach ($listeners['other'] as $pid => $command) {
    NOTE('%d %s', $pid, $command);
  }

  quit(1);
}

kill_processes(array_keys($listeners['own']));

TASK('Starting the PHP webserver.');
mkdir_or_fail(dirname($webserver_log));
passthru(sprintf('nohup php%s -S %s:%s -t %s %s >%s 2>&1 &', $xdebug_flags, escapeshellarg($webserver_host), escapeshellarg($webserver_port), escapeshellarg($docroot), escapeshellarg($docroot . '/.ht.router.php'), escapeshellarg($webserver_log)));

NOTE('Waiting up to %s seconds for the server to be ready.', (string) $webserver_wait_timeout);

if (!wait_for_port($webserver_host, $webserver_port, $webserver_wait_timeout)) {
  $content = @file_get_contents($webserver_log) ?: '';
  FAIL('Unable to start inbuilt PHP server' . ($content !== '' ? "\n" . $content : ''));
}

PASS('Server started successfully.');

TASK('Checking that the server can serve content.');
$context = stream_context_create(['http' => ['method' => 'HEAD', 'timeout' => 5, 'ignore_errors' => TRUE]]);
$headers = @get_headers(sprintf('http://%s:%s', $webserver_host, $webserver_port), FALSE, $context);

if ($headers === FALSE || !isset($headers[0]) || (!str_contains($headers[0], '200') && !str_contains($headers[0], '302'))) {
  FAIL('Server is started, but site cannot be served.');
}

PASS('Server can serve content.');

if (tunnel_enabled()) {
  tunnel_start($webserver_port);
}

// Run custom post-start scripts from "scripts/start-*.sh", if any.
run_custom_scripts('scripts', 'start-');

$site_url = resolve_site_url($webserver_host, $webserver_port);

echo PHP_EOL;
echo '===============================' . PHP_EOL;
echo '    💻 ENVIRONMENT READY  ✅  ' . PHP_EOL;
echo '===============================' . PHP_EOL;
echo PHP_EOL;
echo 'Directory : ' . $docroot . PHP_EOL;
echo 'URL       : ' . $site_url . PHP_EOL;
echo 'XDebug    : ' . ($xdebug_enabled ? 'Enabled' : 'Disabled') . PHP_EOL;
echo PHP_EOL;
echo '> Next steps:' . PHP_EOL;
echo '  vendor/bin/eddy-provision    # Provision the website' . PHP_EOL;
echo PHP_EOL;
