#!/usr/bin/env php
<?php

/**
 * @file
 * Provision a website using existing codebase.
 *
 * - Installs Drupal using SQLite database.
 * - Adds the Basic page and Article content types when the standard profile
 *   has none.
 * - Enables the extension and its suggested modules and themes.
 * - Serves site and generates one-time login link.
 */

declare(strict_types=1);

namespace DrevOps\Eddy\Tooling;

require_once __DIR__ . '/helpers.php';

// -----------------------------------------------------------------------------
// Variables.
// -----------------------------------------------------------------------------

// Webserver host and port resolved via the env -> '.env' -> default
// chain.
$webserver = resolve_webserver();
$webserver_host = $webserver['host'];
$webserver_port = $webserver['port'];

// Drupal profile to use when installing the site.
$drupal_profile = drupal_profile();

$root = (string) getcwd();

// -----------------------------------------------------------------------------

echo '===============================' . PHP_EOL;
echo '         🚀 PROVISION          ' . PHP_EOL;
echo '===============================' . PHP_EOL;
echo PHP_EOL;

$extension_info = extension_info();
$extension_name = $extension_info['name'];
$extension_type = $extension_info['type'];

$db_file = site_db_file($extension_name);

TASK('Installing Drupal into SQLite database %s.', $db_file);

$exit_code = 0;
$db_status = trim(drush('status --field=db-status', NULL, $exit_code));

if ($db_status === 'Connected') {
  drush('sql:drop -y', NULL, $exit_code);
}

drush('site-install %s -y --db-url=%s --account-name=admin install_configure_form.enable_update_status_module=NULL install_configure_form.enable_update_status_emails=NULL', [
  $drupal_profile,
  'sqlite://localhost/' . $db_file,
]);

PASS('Drupal installed.');

drush('status');

// The standard profile installs no content types from Drupal 11.4. Add them
// before the extension, whose install hooks may expect them.
if ($drupal_profile === 'standard' && !is_file('build/web/core/profiles/standard/config/install/node.type.page.yml')) {
  TASK('Adding the Basic page and Article content types.');
  drush('recipe %s', [dirname(__DIR__) . '/recipes/content_types']);
  PASS('Content types added.');
}

TASK('Enabling extension %s.', $extension_name);

if ($extension_type === 'theme') {
  drush('theme:enable %s', [$extension_name]);
}
else {
  drush('pm:enable %s', [$extension_name]);
}

PASS('Extension enabled.');

TASK('Clearing caches.');
drush('cr');
PASS('Caches cleared.');

TASK('Enabling suggested extensions, if any.');
$extension_json = json_file('composer.json');

if (isset($extension_json['suggest']) && is_array($extension_json['suggest'])) {
  $package_types = locked_packages('build/composer.lock', 'type');

  foreach (array_keys($extension_json['suggest']) as $suggest) {
    if (!str_starts_with((string) $suggest, 'drupal/')) {
      continue;
    }

    // A key can carry a version constraint, such as 'drupal/token:^2.0'.
    $package = explode(':', (string) $suggest)[0];
    $suggested_name = substr($package, strlen('drupal/'));

    if (in_array($package_types[$package] ?? '', ['drupal-theme', 'drupal-custom-theme'], TRUE)) {
      drush('theme:enable %s', [$suggested_name]);
    }
    else {
      drush('pm:enable %s', [$suggested_name]);
    }
  }
}

PASS('Suggested extensions enabled.');

TASK('Pre-warming caches.');
@file_get_contents(sprintf('http://%s:%s', $webserver_host, $webserver_port));
PASS('Caches pre-warmed.');

TASK('Linking browser test output into %s.', LOGS_DIR . '/browser_output');
link_browser_output($root . '/build/web', $root . '/' . LOGS_DIR);
PASS('Browser test output linked.');

if (tunnel_enabled()) {
  tunnel_write_settings('build/web/sites/default/settings.php');
}

// Run custom post-provision scripts from "scripts/provision-*.sh", if any.
run_custom_scripts('scripts', 'provision-');

$site_url = resolve_site_url($webserver_host, $webserver_port);
$login_link = login_link($site_url);

echo PHP_EOL;
echo '===============================' . PHP_EOL;
echo '   🚀 PROVISION COMPLETE  ✅  ' . PHP_EOL;
echo '===============================' . PHP_EOL;
echo PHP_EOL;
echo 'Site URL:            ' . $site_url . PHP_EOL;
echo 'One-time login link: ' . $login_link . PHP_EOL;
echo PHP_EOL;

if (is_file('.ahoy.yml')) {
  echo 'Run `ahoy` to see available commands.' . PHP_EOL;
}

if (is_file('Makefile')) {
  echo 'Run `make help` to see available commands.' . PHP_EOL;
}

echo PHP_EOL;
