#!/usr/bin/env php
<?php

/**
 * @file
 * Stop development environment.
 */

declare(strict_types=1);

namespace DrevOps\Eddy\Tooling;

require_once __DIR__ . '/helpers.php';

// -----------------------------------------------------------------------------
// Variables.
// -----------------------------------------------------------------------------

// Webserver port resolved via the env -> '.env' -> default chain.
$webserver_port = resolve_webserver()['port'];

// The docroot identifies the webserver of this project among the processes
// that listen on the port.
$root = (string) getcwd();
$docroot = $root . '/build/web';

// -----------------------------------------------------------------------------

echo '===============================' . PHP_EOL;
echo '      💻 STOP ENVIRONMENT      ' . PHP_EOL;
echo '===============================' . PHP_EOL;
echo PHP_EOL;

// Run custom pre-stop scripts from "scripts/stop-*.sh" while the server is
// still reachable, if any.
run_custom_scripts('scripts', 'stop-');

tunnel_stop();

TASK('Stopping previously started services on port %s, if any.', $webserver_port);
$listeners = webserver_listeners($webserver_port, $docroot);
kill_processes(array_keys($listeners['own']));
sleep(1);
PASS('Services stopped on port %s.', $webserver_port);

note_port_in_use($webserver_port, $listeners['other']);

echo PHP_EOL;
echo '===============================' . PHP_EOL;
echo '   💻 ENVIRONMENT STOPPED ✅  ' . PHP_EOL;
echo '===============================' . PHP_EOL;
echo PHP_EOL;
