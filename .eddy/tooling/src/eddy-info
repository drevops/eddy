#!/usr/bin/env php
<?php

/**
 * @file
 * Print a read-only summary of the current development environment.
 *
 * Resolves PHP, Drupal, Composer, Drush, Node, and npm versions; the
 * webserver host and port along with where each value was sourced from
 * (shell env vs '.env' vs default); the running server's XDebug state; the
 * WebDriver port, which the summary shows only in a project with
 * FunctionalJavascript tests; the build directory; the SQLite database path;
 * and the active Drupal install profile.
 *
 * Any value that cannot be resolved prints '-' rather than failing.
 *
 * Two output modes:
 * - No arguments: print the formatted full summary.
 * - 'eddy-info <field>': print only that field's value on stdout, exit 0.
 *   Unknown field name prints '-' and exits 1.
 *
 * Field-mode keeps expensive subprocess probes lazy: only the requested
 * field's resolver runs.
 */

declare(strict_types=1);

namespace DrevOps\Eddy\Tooling;

require_once __DIR__ . '/helpers.php';

// -----------------------------------------------------------------------------
// Cheap resolutions (env + filesystem). Always run.
// -----------------------------------------------------------------------------

$webserver = resolve_webserver(validate_port: FALSE);
$webserver_host = $webserver['host'];
$host_source = $webserver['host_source'];
$webserver_port = $webserver['port'];
$port_source = $webserver['port_source'];

$drupal_profile = drupal_profile();

$root = (string) getcwd();
$build_dir = is_dir($root . '/build') ? $root . '/build' : '-';
$has_functional_javascript = is_dir($root . '/tests/src/FunctionalJavascript');

$info_files = glob('*.info.yml');
$extension_name = (is_array($info_files) && $info_files !== []) ? basename($info_files[0], '.info.yml') : '';
$db_file = $extension_name !== '' ? site_db_file($extension_name) : '-';

$drush_bin = 'build/vendor/bin/drush';
$has_drush = is_file($drush_bin);

// -----------------------------------------------------------------------------
// Field resolvers. Each closure is invoked only when its field is requested.
// -----------------------------------------------------------------------------

$fields = [
  'drupal-version' => fn(): string => $has_drush ? info_drupal_version($drush_bin, $root) : '-',
  'php-version' => info_php_version(...),
  'composer' => fn(): string => info_tool_version('composer --version 2>/dev/null', '/Composer(?:\s+version)?\s+(\S+)/i'),
  'drush' => fn(): string => $has_drush ? info_tool_version(escapeshellarg($drush_bin) . ' --version 2>/dev/null', '/(\d+\.\d+\.\d+)/') : '-',
  'node' => fn(): string => info_tool_version('node --version 2>/dev/null', '/v?(.+)/'),
  'npm' => fn(): string => info_tool_version('npm --version 2>/dev/null', '/(.+)/'),
  'webserver-host' => fn(): string => $webserver_host,
  'webserver-port' => fn(): string => $webserver_port,
  'site-url' => fn(): string => resolve_site_url($webserver_host, $webserver_port),
  'xdebug' => fn(): string => xdebug_state($webserver_port, $root . '/build/web'),
  'webdriver-port' => fn(): string => resolve_webdriver_port(validate_port: FALSE)['port'],
  'build-dir' => fn(): string => $build_dir,
  'database' => fn(): string => $db_file,
  'drupal-profile' => fn(): string => $drupal_profile,
];

// -----------------------------------------------------------------------------
// Field-mode dispatch.
// -----------------------------------------------------------------------------

$field = isset($argv[1]) && !str_starts_with($argv[1], '-') ? $argv[1] : NULL;

if ($field !== NULL) {
  if (isset($fields[$field])) {
    echo $fields[$field]() . PHP_EOL;
    quit(0);
  }

  echo '-' . PHP_EOL;
  quit(1);
}

// -----------------------------------------------------------------------------
// Full summary. Resolves every field then formats.
// -----------------------------------------------------------------------------

$values = array_map(fn(callable $cb): string => $cb(), $fields);
$php_path = command_path('php');

echo '===============================' . PHP_EOL;
echo '      ℹ️ ENVIRONMENT INFO      ' . PHP_EOL;
echo '===============================' . PHP_EOL;
echo PHP_EOL;
echo 'Drupal version:     ' . $values['drupal-version'] . PHP_EOL;
echo 'PHP version:        ' . $values['php-version'] . ($php_path !== FALSE && $values['php-version'] !== '-' ? ' (' . $php_path . ')' : '') . PHP_EOL;
echo 'Composer:           ' . $values['composer'] . PHP_EOL;
echo 'Drush:              ' . $values['drush'] . PHP_EOL;
echo 'Node / npm:         ' . $values['node'] . ' / ' . $values['npm'] . PHP_EOL;
echo PHP_EOL;
echo 'Webserver host:     ' . $values['webserver-host'] . ' (' . $host_source . ')' . PHP_EOL;
echo 'Webserver port:     ' . $values['webserver-port'] . ' (' . $port_source . ')' . PHP_EOL;
echo 'Site URL:           ' . $values['site-url'] . PHP_EOL;
echo 'XDebug:             ' . $values['xdebug'] . PHP_EOL;

if ($has_functional_javascript) {
  echo 'WebDriver port:     ' . $values['webdriver-port'] . PHP_EOL;
}

echo PHP_EOL;
echo 'Build dir:          ' . $values['build-dir'] . PHP_EOL;
echo 'Database:           ' . $values['database'] . PHP_EOL;
echo 'Drupal profile:     ' . $values['drupal-profile'] . PHP_EOL;
echo PHP_EOL;

// -----------------------------------------------------------------------------
// Local helpers.
// -----------------------------------------------------------------------------

/**
 * Get the host PHP version, or '-' if it cannot be parsed.
 */
function info_php_version(): string {
  $output = (string) @shell_exec('php -v 2>/dev/null');

  if ($output === '' || !preg_match('/^PHP\s+(\S+)/m', $output, $matches)) {
    return '-';
  }

  return $matches[1];
}

/**
 * Run a version probe and extract the first capture group.
 *
 * Returns '-' if the command produces no output or the pattern does
 * not match.
 */
function info_tool_version(string $command, string $pattern): string {
  $output = trim((string) @shell_exec($command));

  if ($output === '' || !preg_match($pattern, $output, $matches)) {
    return '-';
  }

  return trim($matches[1]);
}

/**
 * Get the installed Drupal version via drush, or '-' if unavailable.
 */
function info_drupal_version(string $drush_bin, string $root): string {
  // Intentionally bypasses drush(): outside debug mode that helper merges
  // stderr into its return value, which would leak any stray notice into
  // the version string returned here. This probe
  // instead discards stderr so it always yields either a clean value or '-'.
  $command = escapeshellarg($drush_bin) . ' -r ' . escapeshellarg($root . '/build/web') . ' status --field=drupal-version 2>/dev/null';
  $output = trim((string) @shell_exec($command));

  return $output === '' ? '-' : $output;
}
